# Lifeline backend configuration — copy to backend/.env and fill in.
# .env is gitignored. NEVER commit real values.
#
# The backend reads these at runtime (see app/config.py). When
# BEDROCK_KNOWLEDGE_BASE_ID is empty the backend still runs — the Bedrock
# service becomes a safe no-op so the calculator and API work offline.

# AWS region for Bedrock calls. Our project region is us-east-2.
AWS_REGION=us-east-2

# The existing Bedrock Knowledge Base (owned by the RAG developer).
# Supplied separately; drop it in here when ready.
BEDROCK_KNOWLEDGE_BASE_ID=E9CJNNHXLT

# The Bedrock foundation model used to EXPLAIN results (never to do math).
# Verified working in this project (us-east-2) via an inference profile.
# Nova Lite = Amazon's own model, cost-effective, plain-language friendly.
# Swap to us.anthropic.claude-haiku-4-5-20251001-v1:0 for higher-quality prose.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# The AWS CLI/SDK profile to use for credentials (matches `aws login`).
AWS_PROFILE=lifeline
