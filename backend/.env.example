# Lifeline backend configuration — copy to backend/.env and fill in.
# .env is gitignored. NEVER commit real values.
#
# The hosted API is backend/index.mjs. The Python app reads this file from
# backend/.env no matter which directory you start it from.

AWS_REGION=us-east-2

# Bedrock. Leave the knowledge base id empty to run the calculator offline.
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_PROFILE=lifeline

# S3 bucket that holds documents and the Lambda deploy zip. No account id here.
LIFELINE_BUCKET=
DOCUMENT_BUCKET=

# CloudFront distribution id for frontend/deploy.ps1.
LIFELINE_DISTRIBUTION_ID=

# Public API origin, no trailing slash. Also copied into frontend/config.js.
LIFELINE_API_BASE=

# Signs the browser session token. Required on the Lambda for tamper checks.
# Generate one locally; do not commit it.
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API.
# http://localhost and http://127.0.0.1 are always allowed.
CORS_ORIGINS=

# When both are set, "send to an advisor" stores the assessment and notifies.
# When either is empty, the API says the estimate was not sent.
ASSESSMENTS_TABLE=
AGENT_REVIEW_TOPIC_ARN=

# Gemini Live. Server-side only. The hosted text Lambda does not use this.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
